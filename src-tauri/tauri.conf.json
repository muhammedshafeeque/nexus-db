{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus DB",
  "version": "0.1.0",
  "identifier": "dev.nexusdb.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexus DB",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "Nexus DB <dev@nexusdb.app>",
    "category": "DeveloperTool",
    "shortDescription": "One client for every database",
    "longDescription": "Nexus DB is a desktop client for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB, ArangoDB, Redis, ClickHouse, and Elasticsearch.",
    "linux": {
      "deb": {
        "section": "database",
        "priority": "optional",
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "desktopTemplate": "nexus-db.desktop"
      }
    }
  }
}
